# Copy to .env for a fresh checkout. Values below are LOCAL DEVELOPMENT examples.
# If .env already exists, merge missing settings instead of overwriting it.
HOST=127.0.0.1
PORT=5800

# Optional PostgreSQL/PostGIS Docker service (app/ backend, postgres profile).
# Retains the image selected by the existing project; do not upgrade a populated volume blindly.
POSTGIS_IMAGE=postgis/postgis:16-3.4
POSTGRES_USER=aab
POSTGRES_PASSWORD=aab_dev_password
POSTGRES_DB=aab
POSTGRES_TEST_DB=aab_test
POSTGRES_PORT=5432
# Keep these URLs in sync with the POSTGRES_* values; URL-encode special characters.
DATABASE_URL=postgresql+psycopg://aab:aab_dev_password@127.0.0.1:5432/aab
TEST_DATABASE_URL=postgresql+psycopg://aab:aab_dev_password@127.0.0.1:5432/aab_test
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_TTL_MIN=60
SCHEDULER_ENABLED=false
PIPELINE_CRON='0 1 * * *'
FLAGS=

# Default MySQL Docker service (main.py authentication backend).
MYSQL_DATABASE=aab_auth
MYSQL_USER=aab_auth
MYSQL_PASSWORD=aab_auth_dev_password
MYSQL_ROOT_PASSWORD=aab_root_dev_password
# Host port 3307 avoids an existing local MySQL installation on 3306.
MYSQL_PORT=3307
DATABASE_DIALECT=mysql
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3307
DATABASE_NAME=aab_auth
DATABASE_USER=aab_auth
DATABASE_PASSWORD=aab_auth_dev_password
JWT_SECRET_KEY=replace-with-another-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# Transactional auth email. Local capture: docker compose --profile mail up -d mail
# Mailpit inbox: http://127.0.0.1:8025 (no messages sent to external mailboxes).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=accounts@aab.test
SMTP_FROM_NAME='Aab o Hisaab'
# Production: authenticated SMTP with SMTP_SECURITY=starttls (587) or ssl (465).
# Keep this secret stable; changing it invalidates outstanding codes/reset grants.
AUTH_CODE_SECRET=replace-with-a-random-secret-at-least-32-characters

# Optional demo seeding. Replace before creating demo accounts.
SEED_USER_PASSWORD=replace-with-a-demo-password-12-characters-or-longer
# Only required by the original artisan.py users seeder; use actual district UUIDs.
SEED_DADU_DISTRICT_ID=
SEED_BUNER_DISTRICT_ID=

# NASA POWER ingestion and context data (defaults are usable).
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
POWER_LOOKBACK_DAYS=10
POWER_EXPECTED_LAG_DAYS=3
POWER_MAX_COPY_FORWARD_DAYS=3
POWER_MAX_WORKERS=4
POWER_TIMEOUT_S=60
POWER_MAX_RETRIES=3
POWER_RETRY_BASE_S=2
POWER_RAIN_MAX_MM=600
CONTEXT_INDICATORS_FILE=data/seeds/context_indicators.csv
CONTEXT_REFRESH_CRON='0 2 1 * *'
WORLD_BANK_BASE_URL=https://api.worldbank.org/v2
WORLD_BANK_POVERTY_CODE=SI.POV.NAHC

# Earth Engine: only required for live satellite/IMERG and terrain scripts.
GEE_SERVICE_ACCOUNT=
GEE_KEY_FILE=secrets/gee-key.json
GEE_PROJECT=
GEE_HIGH_VOLUME=true

# Forecasting and ML artifacts.
OPEN_METEO_BASE=https://api.open-meteo.com
OPEN_METEO_MODEL=best_match
OPEN_METEO_API_KEY=
FORECAST_ARTIFACT_DIR=ml/artifacts
FORECAST_MODES_DIR=ml/config/modes
FORECAST_DEFAULT_THRESHOLDS=40,60,80
FLOOD_MODE_SEED=data/seeds/flood_modes.yaml

# Replay caches and timing.
REPLAY_CACHE_ROOT=data/replay
REPLAY_DEFINITIONS=data/replay/scenarios.yaml
REPLAY_SPINUP_DAYS=30
REPLAY_POWER_LAG_DAYS=2
REPLAY_IMERG_LAG_DAYS=1
REPLAY_PIPELINE_TIME_UTC=01:00
REPLAY_MAX_STEP_DAYS=60
REPLAY_AUTOPLAY_MIN_INTERVAL_S=2
